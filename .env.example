# Copy to .dev.vars (read by wrangler and the scripts) and to .env (read by `npm run dev`).
# Both files are git-ignored. See docs/cms-plan/09-environments.md for what each one is.

# Neon, branch `dev` (never main) -------------------------------------------------
DATABASE_URL=postgres://tnl_app:...@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_BUILD=postgres://tnl_build:...@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Pull-request previews (Workers Builds, any branch but main) use these instead, if set:
# DATABASE_URL_PREVIEW=  DATABASE_URL_BUILD_PREVIEW=  STORAGE_ENDPOINT_PREVIEW=  STORAGE_ACCESS_KEY_ID_PREVIEW= …
# Owner role, only for `npm run db:migrate` and scripts/sql/roles.sql
DATABASE_URL_OWNER=postgres://neondb_owner:...@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Neon Object Storage (leave STORAGE_ENDPOINT empty to use the local .local-bucket/ folder) -
STORAGE_ENDPOINT=
STORAGE_BUCKET=media
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_READ_KEY_ID=
STORAGE_READ_SECRET=

# Auth ----------------------------------------------------------------------------------
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:5173
# Empty in local development = gate off
ADMIN_GATE_USER=
ADMIN_GATE_PASSWORD=
# 1 = sign in with the password alone, no e-mailed code (`npm run dev` only, ignored when deployed)
AUTH_SKIP_OTP=
# Only for scripts/seed-account.ts and scripts/send-invite.ts
ADMIN_EMAIL=grouptnl@outlook.com

# Mail (empty BREVO_API_KEY = codes and notifications are printed to the console) -------
BREVO_API_KEY=
MAIL_FROM=noreply@tnlgroup.be
MAIL_FROM_NAME=TNL Group
MAIL_REPLY_TO=grouptnl@outlook.com

# Publish -------------------------------------------------------------------------------
DEPLOY_HOOK_URL=
BUILD_LOG_URL=
PUBLIC_SITE_URL=http://localhost:5173
# 1 = noindex + blocking robots.txt (default for any host other than tnlgroup.be)
SITE_NOINDEX=

# Contact form --------------------------------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# 1 = refuse submissions without a Turnstile token (breaks the no-JavaScript form)
TURNSTILE_REQUIRE_TOKEN=

# Daily cron (media sweep, 12-month retention) -------------------------------------------
CRON_SECRET=generate-a-long-random-string
