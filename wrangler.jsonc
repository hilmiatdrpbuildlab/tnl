{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tnl-website",
	// Written by @sveltejs/adapter-cloudflare; scripts/add-scheduled.ts appends the cron handler.
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_als", "nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
		"not_found_handling": "404-page"
	},
	"observability": { "enabled": true },
	// Daily at 03:00 UTC: media sweep (files unused > 24 h) and 12-month submissions retention.
	"triggers": { "crons": ["0 3 * * *"] },
	// Contact form rate limit. The binding only supports 10 s or 60 s periods, so this is the
	// first line (5 per 60 s); src/lib/server/ratelimit.ts adds the 5-per-10-minutes window.
	"ratelimits": [
		{ "name": "SUBMIT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
	],
	"vars": {
		"STORAGE_BUCKET": "media",
		"MAIL_FROM": "noreply@tnlgroup.be",
		"MAIL_FROM_NAME": "TNL Group",
		"MAIL_REPLY_TO": "grouptnl@outlook.com"
		// Set per environment in the dashboard: STORAGE_ENDPOINT, BETTER_AUTH_URL, PUBLIC_SITE_URL,
		// TURNSTILE_SITE_KEY, BUILD_LOG_URL. Secrets: see .env.example.
	}
}
