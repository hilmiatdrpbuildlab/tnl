{
	"name": "tnl-website",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "npm run build-content --silent && npm run build-images --silent && npm run build-enhance --silent && vite dev",
		"build": "npm run build-content && npm run build-images && npm run build-enhance && vite build && npm run add-scheduled && npm run verify-build",
		"build:app": "vite build",
		"build-images": "tsx scripts/build-images.ts",
		"verify-build": "tsx scripts/verify-build.ts",
		"mark-live": "tsx scripts/mark-live.ts",
		"preview": "wrangler dev",
		"check": "npm run build-content --silent && npm run build-enhance --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/migrate.ts",
		"db:seed": "tsx scripts/seed-content.ts",
		"seed:account": "tsx scripts/seed-account.ts",
		"auth:generate": "npx auth@1 generate --config src/lib/server/auth-cli.ts --output src/lib/server/db/auth-schema.ts",
		"export-seed": "tsx scripts/export-seed.ts",
		"storage:smoke": "tsx scripts/storage-smoke.ts",
		"send-invite": "tsx scripts/send-invite.ts",
		"build-content": "tsx scripts/build-content.ts",
		"add-scheduled": "tsx scripts/add-scheduled.ts",
		"deploy": "wrangler deploy && npm run mark-live",
		"e2e:admin": "tsx scripts/e2e-admin.ts",
		"e2e:responsive": "tsx scripts/responsive.ts",
		"build-enhance": "tsx scripts/build-enhance.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1143.0",
		"@neondatabase/serverless": "^1.1.0",
		"better-auth": "^1.7.6",
		"drizzle-orm": "^0.45.3",
		"marked": "^18.0.14",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@cloudflare/workers-types": "^5.20260930.2",
		"@electric-sql/pglite": "^0.5.8",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.0.0",
		"@types/pg": "^8.23.1",
		"dotenv": "^18.0.4",
		"drizzle-kit": "^0.31.11",
		"esbuild": "^0.28.2",
		"eslint": "^10.11.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"pg": "^8.23.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^3.5.2",
		"sharp": "^0.35.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.1",
		"vitest": "^5.0.3",
		"wrangler": "^4.144.0"
	}
}
